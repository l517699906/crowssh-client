{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "editor-window",
  "description": "Capability for remote text editor windows",
  "windows": ["editor-*"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-title"
  ]
}
